        const cardElement = document.getElementById('activeCard');

        // 通用全息彈窗
        function showModal(title, bodyText) {
            document.getElementById('modal-title').innerHTML = title;
            document.getElementById('modal-body').innerText = bodyText;
            document.getElementById('custom-modal').classList.add('active');
        }

        function closeModal(event) {
            if (!event || event.target.id === 'custom-modal') {
                document.getElementById('custom-modal').classList.remove('active');
            }
        }

        // 路由切換引擎
        function navigateTo(id) {
            document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
            const targetView = document.getElementById(`view-${id}`);
            if(targetView) targetView.classList.add('active');
            
            document.querySelectorAll('.sub-nav span').forEach(s => s.classList.remove('active'));
            const targetNav = document.getElementById(`nav-${id}`);
            if(targetNav) targetNav.classList.add('active');

            if(id === 'mall') renderMall();
            if(id === 'apple-shop') renderAppleShop();
            if(id === 'cart') renderCart();
            window.scrollTo({top: 0, behavior: 'smooth'});
        }

        function openSystemDatabase(type) {
            if(type === 'chitin') {
                showModal('🧬 甲殼素機電學院資料庫', '系統提示：正在連線至深海無人載具核心伺服器...\n已成功解鎖 8 條量子路由通道，為您導向有機生物質與第三代半導體共振之研究文獻庫。');
            } else if(type === 'aesthetic') {
                showModal('🎨 全息美學部矩陣中心', '歡迎來到學務兼教務主任「偉大的神 RAIN」的主場。\n此處正在進行 25px 磨砂玻璃渲染、動態流光溢彩與高奢黑洞級 UI 交互之極限黑卡美學調教測試。');
            } else if(type === 'fluid') {
                showModal('🔪 盲眼流體力學實驗數據', '核心參數加載中：無視覺輔助高精準受力點分析。\n此處提供精準切入生物外殼應力分佈之全動態數學模型，為全球剝蝦大賽提供統治級理論支持。');
            }
        }

        function showDetail(title, desc) {
            showModal(`【YBS 巔峰事蹟詳細】\n${title}`, desc);
        }

        function renderCalendar() {
            const container = document.getElementById('calendar-container');
            container.innerHTML = calendarEvents.map(e => `
                <div class="calendar-item" onclick="showModal('📅 活動：${e.title}', '【地點】${e.loc}\\n\\n【詳情】${e.desc}')">
                    <div class="cal-date"><span>${e.date}</span><small>${e.month}</small></div>
                    <div class="cal-info">
                        <h4>${e.title}</h4>
                        <p>${e.desc}</p>
                    </div>
                </div>
            `).join('');
        }

        function renderLunch() {
            const container = document.getElementById('lunch-container');
            container.innerHTML = lunchMenu.map(m => `
                <div class="lunch-item" onclick="showModal('🍱 ${m.day} 核心膳食詳細', '【品名】${m.name}\\n【熱量】${m.cal}\\n\\n【營養特點】\\n${m.desc}')">
                    <div class="lunch-day">${m.day}</div>
                    <div class="lunch-emoji">${m.emoji}</div>
                    <div class="lunch-main-dish">${m.name}</div>
                    <div class="lunch-calories">${m.cal}</div>
                </div>
            `).join('');
        }

        function renderMall() {
            const container = document.getElementById('mall-list');
            container.innerHTML = products.map(p => `
                <div class="prod-card" onclick="viewDetail(${p.id}, 'normal')">
                    <div class="prod-img-box">${p.emoji}</div>
                    <div class="prod-info">
                        <div class="prod-title" style="font-weight:700;">${p.name}</div>
                        <div class="prod-price">NT$ ${p.price.toLocaleString()}</div>
                    </div>
                </div>
            `).join('');
        }

        function renderAppleShop() {
            const container = document.getElementById('apple-shop-list');
            container.innerHTML = appleProducts.map(p => `
                <div class="epic-card" onclick="viewDetail(${p.id}, 'apple')">
                    <div class="apple-icon" style="font-size: 3rem;">${p.emoji}</div>
                    <h3>${p.name}</h3>
                    <p>${p.desc}</p>
                    <div class="prod-price" style="margin-top:15px;">NT$ ${p.price.toLocaleString()}</div>
                </div>
            `).join('');
        }

        function viewDetail(id, type) {
            const p = (type === 'apple') ? appleProducts.find(i => i.id === id) : products.find(i => i.id === id);
            document.getElementById('detail-content').innerHTML = `
                <div style="flex:1; min-width:300px; background:#0a0a0c; border-radius:20px; font-size:10rem; display:flex; align-items:center; justify-content:center; padding: 40px; border: 1px solid var(--border);">
                    ${p.emoji}
                </div>
                <div style="flex:1.2; min-width:300px; display:flex; flex-direction:column; justify-content:center;">
                    <h1 style="font-size:3rem; margin-bottom:20px; letter-spacing: -0.03em;">${p.name}</h1>
                    <div class="ios-panel" style="padding:25px; margin-bottom: 25px;">
                        <p style="font-size:1.4rem; color:var(--accent); font-weight:800;">NT$ ${p.price.toLocaleString()}</p>
                        <p style="margin-top:15px; color:var(--text-secondary); line-height:1.8; font-size:1rem;">${p.desc}</p>
                    </div>
                    <div>
                        <button class="cta-btn" onclick="addToCart('${p.name}', ${p.price}, '${p.emoji}')">加入黑卡購物車</button>
                    </div>
                </div>
            `;
            navigateTo('detail');
        }

        function addToCart(name, price, emoji) {
            cart.push({name, price, emoji});
            const badge = document.getElementById('global-count');
            badge.innerText = cart.length;
            badge.classList.remove('badge-pop');
            void badge.offsetWidth; 
            badge.classList.add('badge-pop');
            showModal('🛒 矩陣同步成功', `已成功將【${name}】同步至您的校園黑卡核心清單。`);
        }

        function renderCart() {
            const container = document.getElementById('cart-list');
            if(cart.length === 0) {
                container.innerHTML = "<p style='text-align:center; padding:50px; color:var(--text-secondary);'>清單暫無物資，請前往自營商城補充能量。</p>";
                document.getElementById('total-price').innerText = "NT$ 0";
                return;
            }
            container.innerHTML = cart.map((item, idx) => `
                <div class="list-row">
                    <span style="font-weight:600;">${item.emoji} ${item.name}</span>
                    <span style="color:var(--accent); font-weight:700;">NT$ ${item.price.toLocaleString()}</span>
                </div>
            `).join('');
            const total = cart.reduce((sum, item) => sum + item.price, 0);
            document.getElementById('total-price').innerText = `NT$ ${total.toLocaleString()}`;
        }

        function checkoutCart() {
            if(cart.length === 0) {
                showModal('⚠️ 系統提示', '您的購物車目前空空如也，無法啟動結帳矩陣。');
                return;
            }
            showModal('💳 付款矩陣已確認', '安全結帳完成！物資付款代碼已寫入量子區塊鏈。\n專屬「物流蝦」正由安南區基地出發，即將以光速下游至您的窗前，請注意接收時空波動。');
            cart = [];
            document.getElementById('global-count').innerText = "0";
            renderCart();
        }

        // 搜尋模組
        function handleSearch(event) {
            if (event.key === "Enter") triggerSearch();
        }

        function triggerSearch() {
            const query = document.getElementById('search-input').value.trim();
            if(!query) {
                showModal('🔍 搜尋中心', '請輸入您想檢索的量子學術關鍵字、處室、午餐或物資。');
                return;
            }
            
            const matchedProducts = products.concat(appleProducts).filter(p => p.name.includes(query) || p.desc.includes(query));
            const matchedEvents = calendarEvents.filter(e => e.title.includes(query) || e.desc.includes(query));
            const matchedLunch = lunchMenu.filter(m => m.name.includes(query) || m.desc.includes(query));
            
            let resultText = `已為您在核心網絡中檢索「${query}」：\n\n`;
            
            if (query.includes("校長") || query.includes("YBS") || query.includes("睿睿")) {
                resultText += "【處室匹配】校長室與至高神殿：最高領袖 YBS 與 偉大的神睿睿 正在釋放甲殼素光輝，指導深海能階運算。\n\n";
            }
            if (query.includes("主任") || query.includes("RAIN") || query.includes("教務") || query.includes("學務") || query.includes("輔導") || query.includes("李偉綸")) {
                resultText += "【處室匹配】核心管理矩陣：包含由「睿睿」主任掌管的教務暨學務聯合處，以及由「輔導主任李偉綸」全權統治的心靈防禦暨學生輔導處。\n\n";
            }

            if (matchedProducts.length === 0 && matchedEvents.length === 0 && matchedLunch.length === 0 && !resultText.includes("匹配")) {
                resultText += "未找到相關維度數據，可能該項目已被觀測坍縮，或權限不足。";
            } else {
                if (matchedProducts.length > 0) {
                    resultText += `【找到 ${matchedProducts.length} 個商城黑卡物資】\n` + matchedProducts.map(p => `• ${p.emoji} ${p.name}`).join('\n') + '\n\n';
                }
                if (matchedEvents.length > 0) {
                    resultText += `【找到 ${matchedEvents.length} 項史詩學術行程】\n` + matchedEvents.map(e => `• [${e.date} ${e.month}] ${e.title}`).join('\n') + '\n\n';
                }
                if (matchedLunch.length > 0) {
                    resultText += `【找到 ${matchedLunch.length} 日量子營養膳食】\n` + matchedLunch.map(m => `• [${m.day}] ${m.name}`).join('\n');
                }
            }
            showModal('🔍 量子矩陣搜尋結果', resultText);
        }

        function toggleLightMode() {
            showModal('🌓 維度屏障提示', '當前系統運作於高奢「黑曜石」暗黑防護矩陣中。為了保護教務主任睿睿 調校的 25px 磨砂玻璃光感美學，系統拒絕坍縮至高亮度白晝模式。');
        }

        // ==================== 抽卡核心邏輯引擎 ====================
        function openPackSequence() {
            const pack = document.getElementById('packNode');
            pack.classList.add('pack-rip-animation');
            updateCapsule("DECODING / 載入全息能階...", "#ff007f");

            setTimeout(() => {
                pack.style.display = 'none';
                document.getElementById('stageGate').style.display = 'block';
                document.getElementById('dockNode').style.display = 'block';
                injectCardContent(indexPointer);
                bind3DEvents(); // 優化雙端 3D 全息事件
            }, 800);
        }

        function injectCardContent(idx) {
            const data = shrimpDatabase[idx];
            updateCapsule("睿睿護航中 [已確認]", "#00f0ff");
            
            document.getElementById('domStage').innerText = data.stage;
            document.getElementById('domName').innerText = data.name;
            document.getElementById('domHP').innerText = data.hp;
            document.getElementById('domType').innerText = data.type;
            document.getElementById('domType').style.backgroundColor = data.color;
            document.getElementById('domImg').style.backgroundImage = `url('${data.img}')`;
            document.getElementById('domRarity').innerText = data.rarity;
            document.getElementById('domFlavor').innerText = data.flavor;

            const skillsContainer = document.getElementById('domSkills');
            skillsContainer.innerHTML = data.skills.map(s => `
                <div class="tactic-item">
                    <div class="tactic-cost">
                        ${s.cost.map(c => `<span class="cost-dot" style="background:${data.color}">${c}</span>`).join('')}
                    </div>
                    <div class="tactic-main">
                        <div class="tactic-header">
                            <span>${s.name}</span>
                            <span class="tactic-dmg">${s.dmg}</span>
                        </div>
                        <div class="tactic-info">${s.desc}</div>
                    </div>
                </div>
            `).join('');

            // 進場動效
            cardElement.style.transition = "none";
            cardElement.style.opacity = "0";
            cardElement.style.transform = "scale(0.92) rotateY(-15deg)";
            setTimeout(() => {
                cardElement.style.transition = "transform 0.8s var(--fluid-ease), opacity 0.5s ease";
                cardElement.style.transform = "scale(1) rotateY(0deg)";
                cardElement.style.opacity = "1";
            }, 40);
        }

        function bind3DEvents() {
            const handleMove = (e) => {
                if (e.type === 'touchmove') e.preventDefault(); // 行動端搓卡防頁面抖動
                const rect = cardElement.getBoundingClientRect();
                const clientX = e.clientX || e.touches?.[0].clientX;
                const clientY = e.clientY || e.touches?.[0].clientY;
                
                if (!clientX || !clientY) return;

                const x = clientX - rect.left;
                const y = clientY - rect.top;
                const xPercent = x / rect.width;
                const yPercent = y / rect.height;
                
                const rotX = (0.5 - yPercent) * 26; 
                const rotY = (xPercent - 0.5) * 26;
                
                cardElement.style.transition = "none";
                cardElement.style.transform = `rotateX(${rotX}deg) rotateY(${rotY}deg) scale(1.03)`;
                cardElement.style.boxShadow = `${-rotY * 1.5}px ${rotX * 1.5}px 45px rgba(0,0,0,0.6), 0 0 25px rgba(0,240,255,0.1)`;
                
                const holo = document.getElementById('holoOverlay');
                holo.style.opacity = "0.55";
                holo.style.backgroundPosition = `${xPercent * 100}% ${yPercent * 100}%`;
            };

            const handleLeave = () => {
                cardElement.style.transition = "transform 0.6s var(--fluid-ease), box-shadow 0.6s ease";
                cardElement.style.transform = "rotateX(0deg) rotateY(0deg) scale(1)";
                cardElement.style.boxShadow = "0 20px 50px rgba(0,0,0,0.5)";
                
                const holo = document.getElementById('holoOverlay');
                holo.style.transition = "opacity 0.6s ease";
                holo.style.opacity = "0";
            };

            cardElement.addEventListener('mousemove', handleMove);
            cardElement.addEventListener('touchmove', handleMove, { passive: false });
            cardElement.addEventListener('mouseleave', handleLeave);
            cardElement.addEventListener('touchend', handleLeave);
        }

        function stepNextCard() {
            indexPointer++;
            if (indexPointer < shrimpDatabase.length) {
                if (indexPointer === shrimpDatabase.length - 1) {
                    const btn = document.getElementById('actionBtn');
                    btn.innerText = "完成收藏矩陣 ➔";
                    btn.style.background = "var(--gold-premium)";
                }
                injectCardContent(indexPointer);
            } else {
                openGalleryGrid();
            }
        }

        function openGalleryGrid() {
            const grid = document.getElementById('galleryGrid');
            grid.innerHTML = shrimpDatabase.map((data, idx) => `
                <div class="gallery-node" onclick="zoomSpecificNode(${idx})">
                    <div class="premium-ptcg-card">
                        <div class="hologram-overlay" style="opacity: 0.1; background-position: ${idx * 20}% 50%;"></div>
                        <div class="card-top-bar">
                            <div class="meta-title">
                                <span class="meta-stage">${data.stage}</span>
                                <span class="meta-name" style="font-size:1.1rem;">${data.name}</span>
                            </div>
                            <div class="meta-hp" style="font-size:1.1rem;">
                                <small>HP</small><span>${data.hp}</span>
                                <span class="type-icon" style="background:${data.color}">${data.type}</span>
                            </div>
                        </div>
                        <div class="photo-window" style="background-image:url('${data.img}')">
                            <div class="rarity-pill">${data.rarity}</div>
                        </div>
                    </div>
                </div>
            `).join('');

            updateCapsule("COLLECTION LOCKED", "#34c759");
            document.getElementById('galleryGate').classList.add('active');
        }

        function zoomSpecificNode(idx) {
            indexPointer = idx;
            document.getElementById('galleryGate').classList.remove('active');
            const btn = document.getElementById('actionBtn');
            if (indexPointer === shrimpDatabase.length - 1) {
                btn.innerText = "完成收藏矩陣 ➔";
                btn.style.background = "var(--gold-premium)";
            } else {
                btn.innerText = "抽下一張 ➔";
                btn.style.background = "#fff";
            }
            injectCardContent(indexPointer);
        }

        function updateCapsule(text, color) {
            document.getElementById('capsuleText').innerText = text;
            const dot = document.querySelector('.status-dot');
            if (dot) {
                dot.style.background = color;
                dot.style.boxShadow = `0 0 10px ${color}`;
            }
        }

        // 量子化安全重置抽卡系統
        function resetGachaPack() {
            indexPointer = 0;
            document.getElementById('galleryGate').classList.remove('active');
            document.getElementById('packNode').style.display = 'block';
            document.getElementById('packNode').classList.remove('pack-rip-animation');
            document.getElementById('stageGate').style.display = 'none';
            document.getElementById('dockNode').style.display = 'none';
            const btn = document.getElementById('actionBtn');
            btn.innerText = "抽下一張 ➔";
            btn.style.background = "#fff";
            updateCapsule("READY / YBS 特輯", "var(--neon-blue)");
        }

        function closeGachaGallery() {
            document.getElementById('galleryGate').classList.remove('active');
            navigateTo('portal');
        }

        // 矩陣初始化
        window.onload = function() {
            renderMall();
            renderCalendar();
            renderLunch();
        };
    </script>
</body>
</html>
