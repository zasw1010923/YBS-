<!DOCTYPE html>
<html lang="zh-Hant-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>YBS 喜蝦科技雙語學校 | 官方旗艦矩陣 </title>
    <style>
        /* 史詩級高奢配色與變數 */
        :root {
            --bg: #070708; /* 黑曜石 */
            --panel: rgba(20, 20, 22, 0.6);
            --panel-hover: rgba(255, 255, 255, 0.08);
            --text-primary: #f5f5f7; /* 鈦空銀 */
            --text-secondary: #8e8e93;
            --accent: #2997ff; /* 科技藍 */
            --border: rgba(255, 255, 255, 0.08);
            --border-hover: rgba(41, 151, 255, 0.4);
            --shimmer: linear-gradient(90deg, transparent, rgba(255,255,255,0.06), transparent);
            --ease: cubic-bezier(0.16, 1, 0.3, 1);
            --blur: 30px;

            /* 抽卡系統變數 */
            --card-base: rgba(255, 255, 255, 0.85);
            --capsule-bg: rgba(20, 20, 25, 0.6);
            --neon-blue: #00f0ff;
            --neon-pink: #ff007f;
            --gold-premium: #d4af37;
            --fluid-ease: cubic-bezier(0.2, 0.8, 0.2, 1);
        }

        /* 全域重設與動態背景流光 */
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Helvetica Neue", sans-serif; }
        
        body { 
            background-color: var(--bg); 
            color: var(--text-primary); 
            padding-top: 150px; 
            overflow-x: hidden; 
            -webkit-font-smoothing: antialiased;
            position: relative;
        }

        /* 氛圍感環境流光巨幕 */
        body::before, body::after {
            content: '';
            position: fixed;
            width: 600px;
            height: 600px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(41, 151, 255, 0.1) 0%, transparent 70%);
            z-index: -1;
            pointer-events: none;
            filter: blur(50px);
        }
        body::before {
            top: -10%;
            left: -10%;
            animation: floatOrb1 20s infinite ease-in-out;
        }
        body::after {
            bottom: -5%;
            right: -10%;
            animation: floatOrb2 25s infinite ease-in-out;
        }

        @keyframes floatOrb1 {
            0%, 100% { transform: translate(0, 0) scale(1); }
            50% { transform: translate(140px, 90px) scale(1.3); }
        }
        @keyframes floatOrb2 {
            0%, 100% { transform: translate(0, 0) scale(1); }
            50% { transform: translate(-120px, -100px) scale(1.2); }
        }
        
        /* 1. 互動導覽列 */
        header {
            position: fixed; top: 0; width: 100%; z-index: 2000;
            background: rgba(10, 10, 12, 0.8); backdrop-filter: blur(var(--blur)); -webkit-backdrop-filter: blur(var(--blur));
            border-bottom: 1px solid var(--border); padding: 15px 50px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.6);
        }
        .header-main { display: flex; justify-content: space-between; align-items: center; }
        
        .logo-group { display: flex; align-items: center; gap: 15px; cursor: pointer; position: relative; }
        .logo-text { font-size: 1.4rem; font-weight: 800; letter-spacing: -0.04em; transition: var(--ease); }
        .logo-motto { position: absolute; top: 100%; left: 0; font-size: 0.7rem; color: var(--accent); opacity: 0; transform: translateY(-10px); transition: all 0.5s var(--ease); pointer-events: none; white-space: nowrap; letter-spacing: 0.1em; }
        
        .logo-group:hover .logo-text { color: var(--accent); transform: translateX(2px); }
        .logo-group:hover .logo-motto { opacity: 1; transform: translateY(5px); }
        .logo-group:hover .school-logo-img { transform: scale(1.1) rotate(8deg); }

        .school-logo-img { 
            width: 45px; 
            height: 45px; 
            object-fit: contain; 
            transition: transform 0.5s var(--ease);
            filter: drop-shadow(0 0 10px rgba(255,255,255,0.2)); 
            animation: shimmerLogo 4s infinite ease-in-out; 
        }

        .search-bar { display: flex; gap: 10px; }
        .search-bar input { 
            background: rgba(255,255,255,0.04); 
            border: 1px solid var(--border); 
            padding: 8px 18px; 
            border-radius: 20px; 
            color: #fff; 
            width: 240px; 
            transition: all 0.4s var(--ease); 
        }
        .search-bar input:focus { border-color: var(--accent); outline: none; background: rgba(255,255,255,0.09); box-shadow: 0 0 15px rgba(41,151,255,0.2); width: 300px; }
        .search-bar button { background: var(--accent); color: white; border: none; padding: 8px 18px; border-radius: 20px; cursor: pointer; font-weight: 600; transition: all 0.3s; }
        .search-bar button:hover { opacity: 0.9; transform: scale(1.05); }

        .nav-actions { display: flex; align-items: center; gap: 30px; }
        .mode-btn { cursor: pointer; font-size: 1.2rem; transition: transform 0.3s; }
        .mode-btn:hover { transform: rotate(180deg); }
        
        .cart-icon { font-size: 1.3rem; cursor: pointer; position: relative; transition: transform 0.2s; }
        .cart-icon:hover { transform: scale(1.1); }
        
        .cart-badge { 
            position: absolute; 
            top: -6px; 
            right: -10px; 
            background: var(--accent); 
            color: #fff;
            font-size: 0.65rem; 
            padding: 2px 7px; 
            border-radius: 20px; 
            font-weight: bold;
            box-shadow: 0 0 10px var(--accent);
            transition: all 0.3s var(--ease);
        }
        .badge-pop { animation: badgePop 0.4s var(--ease) forwards; }

        /* 2. 控制列與滑條動畫 */
        .sub-nav {
            position: fixed; top: 82px; width: 100%; z-index: 1999;
            background: rgba(15, 15, 17, 0.8); backdrop-filter: blur(var(--blur)); -webkit-backdrop-filter: blur(var(--blur));
            border-bottom: 1px solid var(--border); padding: 12px 60px;
            display: flex; gap: 40px; font-size: 0.85rem; font-weight: 600;
            overflow-x: auto; -webkit-overflow-scrolling: touch;
        }
        .sub-nav::-webkit-scrollbar { display: none; }
        .sub-nav span { cursor: pointer; color: var(--text-secondary); transition: all 0.3s; position: relative; padding: 4px 0; white-space: nowrap; }
        .sub-nav span:hover { color: var(--text-primary); }
        .sub-nav span::after {
            content: ''; position: absolute; bottom: -13px; left: 0; width: 100%; height: 2px;
            background: var(--accent); transform: scaleX(0); transform-origin: right; transition: transform 0.4s var(--ease);
        }
        .sub-nav span:hover::after, .sub-nav span.active::after { transform: scaleX(1); transform-origin: left; }
        .sub-nav span.active { color: var(--text-primary); }

        /* 3. 容器與視窗轉換動畫 */
        .container { max-width: 1240px; margin: 40px auto; padding: 0 30px; min-height: 80vh; }
        .view { display: none; }
        .view.active { display: block; animation: iosEnter 0.6s var(--ease) forwards; }

        /* 4. 首頁巨幕中心 */
        .hero-epic { text-align: center; padding: 80px 20px 120px; position: relative; }
        .hero-logo-large { 
            width: 160px; 
            margin-bottom: 35px; 
            filter: drop-shadow(0 0 30px rgba(41, 151, 255, 0.25)); 
            animation: shimmerLogo 4s infinite ease-in-out; 
            transition: transform 0.8s var(--ease);
        }
        .hero-logo-large:hover { transform: scale(1.05) rotate(360deg); }
        .hero-epic h1 { 
            font-size: 4.8rem; 
            font-weight: 800; 
            line-height: 1.1; 
            letter-spacing: -0.05em; 
            background: linear-gradient(180deg, #fff 30%, #555 100%); 
            -webkit-background-clip: text; 
            -webkit-text-fill-color: transparent; 
        }
        .hero-epic p { font-size: 1.4rem; color: var(--text-secondary); margin: 25px auto 45px; max-width: 800px; }
        
        .cta-btn { 
            display: inline-block; 
            background: var(--text-primary); 
            color: var(--bg); 
            padding: 14px 32px; 
            border-radius: 30px; 
            font-weight: 700; 
            cursor: pointer; 
            transition: all 0.4s var(--ease); 
        }
        .cta-btn:hover { 
            background: var(--accent); 
            color: white; 
            transform: translateY(-3px); 
            box-shadow: 0 15px 30px rgba(41, 151, 255, 0.35); 
        }

        /* 5. 卡片元件 */
        .epic-card {
            background: var(--panel); border: 1px solid var(--border); border-radius: 28px;
            padding: 40px; cursor: pointer; transition: all 0.5s var(--ease);
            position: relative; overflow: hidden;
        }
        .epic-card:hover { 
            transform: translateY(-8px) scale(1.02); 
            background: var(--panel-hover); 
            border-color: var(--border-hover); 
            box-shadow: 0 30px 60px rgba(0,0,0,0.6), 0 0 25px rgba(41, 151, 255, 0.15); 
        }
        .epic-card::before { 
            content: ''; position: absolute; top: 0; left: -100%; width: 60%; height: 100%; 
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.08), transparent); 
            transition: none; 
        }
        .epic-card:hover::before { left: 100%; transition: left 0.8s var(--ease); }
        .card-ring { font-size: 2.5rem; margin-bottom: 18px; display: block; transition: transform 0.4s var(--ease); }
        .epic-card:hover .card-ring { transform: scale(1.2) rotate(-5deg); }
        .epic-card h3 { font-size: 1.5rem; margin-bottom: 12px; font-weight: 700; }
        .epic-card p { color: var(--text-secondary); font-size: 0.95rem; line-height: 1.6; }

        .grid-3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 30px; margin-bottom: 40px; }
        .grid-2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(450px, 1fr)); gap: 30px; margin-bottom: 40px; }

        /* 按壓回饋 */
        .epic-card:active, .prod-card:active, .honor-box:active, .calendar-item:active, .cta-btn:active, .modal-close:active, .lunch-item:active, .btn-fluid:active {
            transform: scale(0.97) translateY(0); transition: transform 0.1s ease;
        }

        /* 6. 行事曆與列表組件 */
        .section-title { font-size: 2.5rem; font-weight: 800; margin-bottom: 10px; letter-spacing: -0.03em; }
        .section-subtitle { color: var(--text-secondary); margin-bottom: 40px; font-size: 1.1rem; }
        
        .calendar-list { display: flex; flex-direction: column; gap: 15px; }
        .calendar-item {
            background: var(--panel); border: 1px solid var(--border);
            border-radius: 18px; padding: 25px; display: flex; align-items: center;
            gap: 25px; cursor: pointer; transition: all 0.4s var(--ease);
        }
        .calendar-item:hover { background: var(--panel-hover); border-color: var(--border-hover); padding-left: 38px; box-shadow: 0 10px 30px rgba(0,0,0,0.3); }
        .cal-date { min-width: 80px; text-align: center; border-right: 1px solid var(--border); padding-right: 25px; transition: border 0.3s; }
        .calendar-item:hover .cal-date { border-right-color: var(--accent); }
        .cal-date span { display: block; font-size: 1.4rem; font-weight: 800; color: var(--accent); }
        .cal-date small { font-size: 0.7rem; color: var(--text-secondary); text-transform: uppercase; }
        .cal-info h4 { font-size: 1.1rem; margin-bottom: 4px; }
        .cal-info p { font-size: 0.85rem; color: var(--text-secondary); }

        /* 7. 榮譽榜事蹟 */
        .honor-grid { display: grid; gap: 20px; }
        .honor-box {
            background: var(--panel); border-radius: 24px; padding: 35px;
            border: 1px solid var(--border); cursor: pointer; transition: all 0.4s var(--ease);
            display: flex; justify-content: space-between; align-items: center;
        }
        .honor-box:hover { 
            background: linear-gradient(135deg, rgba(41, 151, 255, 0.08), rgba(255,255,255,0.01)); 
            transform: translateY(-4px); border-color: var(--border-hover); box-shadow: 0 15px 40px rgba(0,0,0,0.4);
        }
        .honor-content h3 { font-size: 1.3rem; margin-bottom: 8px; }
        .honor-content p { font-size: 0.9rem; color: var(--text-secondary); line-height: 1.6; margin-bottom: 12px; }
        .honor-prize { display: inline-block; font-size: 0.75rem; background: rgba(41, 151, 255, 0.12); color: var(--accent); padding: 4px 12px; border-radius: 12px; font-weight: 600; }
        .honor-medal { font-size: 2.5rem; filter: drop-shadow(0 0 10px rgba(255,215,0,0.2)); transition: transform 0.4s var(--ease); }
        .honor-box:hover .honor-medal { transform: scale(1.2) rotate(15deg); }

        /* 8. 商店黑卡風與旗艦橫幅 */
        .apple-cross-banner { 
            background: linear-gradient(90deg, #1c1c1e 0%, #070708 100%); 
            border: 1px solid var(--border); padding: 30px 40px; border-radius: 24px; 
            margin-bottom: 40px; display: flex; justify-content: space-between; align-items: center; 
            cursor: pointer; transition: all 0.4s var(--ease); position: relative; overflow: hidden;
        }
        .apple-cross-banner::before {
            content: ''; position: absolute; top: 0; left: -100%; width: 50%; height: 100%;
            background: linear-gradient(90deg, transparent, rgba(41,151,255,0.05), transparent);
        }
        .apple-cross-banner:hover::before { left: 100%; transition: left 1s var(--ease); }
        .apple-cross-banner:hover { border-color: var(--accent); transform: translateY(-3px); box-shadow: 0 15px 40px rgba(0,0,0,0.5); }
        .cross-banner-text h3 { font-size: 1.4rem; margin-bottom: 5px; }
        .cross-banner-text p { color: var(--text-secondary); font-size: 0.9rem; }
        .cross-arrow { font-size: 1.5rem; color: var(--accent); transition: transform 0.3s var(--ease); }
        .apple-cross-banner:hover .cross-arrow { transform: translateX(6px); }

        .mall-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 25px; }
        .prod-card { background: #121215; border: 1px solid var(--border); border-radius: 20px; overflow: hidden; cursor: pointer; transition: all 0.4s var(--ease); }
        .prod-card:hover { border-color: var(--border-hover); transform: translateY(-6px); box-shadow: 0 15px 35px rgba(0,0,0,0.5); }
        
        .prod-img-box { 
            height: 200px; background: #0a0a0c; display: flex; align-items: center; justify-content: center; 
            font-size: 4rem; transition: all 0.4s var(--ease); 
        }
        .prod-card:hover .prod-img-box { transform: scale(1.05); background: #0e0e12; }
        .prod-info { padding: 20px; position: relative; background: #121215; }
        .prod-price { font-size: 1.2rem; font-weight: 800; color: var(--accent); margin-top: 10px; }

        /* 學校組織、沿革與校長室特製樣式 */
        .profile-container { display: flex; gap: 30px; background: var(--panel); border: 1px solid var(--border); padding: 40px; border-radius: 28px; margin-bottom: 40px; align-items: center; }
        .profile-avatar { font-size: 5rem; background: rgba(255,255,255,0.03); width: 130px; height: 130px; display: flex; align-items: center; justify-content: center; border-radius: 50%; border: 1px solid var(--border); }
        .profile-info h3 { font-size: 1.8rem; margin-bottom: 5px; }
        .profile-info em { color: var(--accent); font-style: normal; font-weight: 600; font-size: 0.95rem; display: block; margin-bottom: 15px; }
        .profile-info p { color: var(--text-secondary); line-height: 1.7; font-size: 0.95rem; }

        .timeline { position: relative; padding-left: 30px; border-left: 2px solid var(--border); margin-top: 20px; }
        .timeline-item { position: relative; margin-bottom: 30px; cursor: pointer; }
        .timeline-item::before { content: ''; position: absolute; left: -36px; top: 5px; width: 10px; height: 10px; border-radius: 50%; background: var(--text-secondary); transition: all 0.3s; }
        .timeline-item:hover::before { background: var(--accent); box-shadow: 0 0 10px var(--accent); }
        .timeline-year { font-weight: 800; color: var(--accent); font-size: 1.2rem; margin-bottom: 5px; }
        .timeline-content h4 { font-size: 1.1rem; margin-bottom: 5px; }
        .timeline-content p { color: var(--text-secondary); font-size: 0.9rem; }

        /* 午餐膳食矩陣 */
        .lunch-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; }
        .lunch-item { background: var(--panel); border: 1px solid var(--border); border-radius: 24px; padding: 25px; text-align: center; cursor: pointer; transition: all 0.4s var(--ease); }
        .lunch-item:hover { border-color: var(--border-hover); background: var(--panel-hover); transform: translateY(-5px); box-shadow: 0 15px 35px rgba(0,0,0,0.4); }
        .lunch-day { font-size: 1.2rem; font-weight: 800; color: var(--accent); margin-bottom: 15px; border-bottom: 1px solid var(--border); padding-bottom: 10px; }
        .lunch-emoji { font-size: 3rem; margin-bottom: 10px; }
        .lunch-main-dish { font-weight: 700; font-size: 1.05rem; margin-bottom: 8px; }
        .lunch-calories { font-size: 0.75rem; color: var(--text-secondary); background: rgba(255,255,255,0.05); padding: 3px 10px; border-radius: 10px; display: inline-block; }

        /* Ypple 專櫃 */
        .back-to-mall-bar { margin-bottom: 30px; }
        .btn-back-mall { background: none; border: 1px solid var(--border); color: var(--text-secondary); padding: 8px 18px; border-radius: 20px; cursor: pointer; transition: all 0.3s; }
        .btn-back-mall:hover { color: #fff; border-color: #fff; background: rgba(255,255,255,0.05); }
        .apple-icon { margin-bottom: 15px; transition: transform 0.4s; }
        .epic-card:hover .apple-icon { transform: translateY(-5px); }

        /* 購物車與詳情頁 */
        .ios-panel { background: var(--panel); border: 1px solid var(--border); border-radius: 24px; padding: 30px; backdrop-filter: blur(var(--blur)); }
        .list-row { display: flex; justify-content: space-between; padding: 18px 0; border-bottom: 1px solid rgba(255,255,255,0.05); animation: iosEnter 0.4s var(--ease); }
        .list-row:last-child { border-bottom: none; }

        /* 詳情排版 */
        .detail-wrapper { display: flex; gap: 50px; animation: iosEnter 0.6s var(--ease); }

        /* 客製化全息彈窗 */
        .modal-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(4, 4, 5, 0.5); backdrop-filter: blur(25px); -webkit-backdrop-filter: blur(25px);
            z-index: 5000; display: flex; align-items: center; justify-content: center;
            opacity: 0; pointer-events: none; transition: all 0.5s var(--ease);
        }
        .modal-overlay.active { opacity: 1; pointer-events: auto; }
        .modal-box {
            background: rgba(25, 25, 28, 0.75); border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 32px;
            width: 90%; max-width: 520px; padding: 40px; box-shadow: 0 40px 100px rgba(0,0,0,0.8), 0 0 40px rgba(41,151,255,0.1);
            transform: scale(0.85) translateY(30px); transition: all 0.5s var(--ease);
            position: relative;
        }
        .modal-overlay.active .modal-box { transform: scale(1) translateY(0); }
        .modal-header { font-size: 1.6rem; font-weight: 800; margin-bottom: 15px; letter-spacing: -0.03em; color: var(--text-primary); display: flex; align-items: center; gap: 12px; }
        .modal-body { color: var(--text-secondary); font-size: 1rem; line-height: 1.7; margin-bottom: 30px; white-space: pre-line; }
        .modal-close { background: var(--text-primary); color: var(--bg); border: none; padding: 12px 28px; border-radius: 24px; cursor: pointer; font-weight: 700; font-size: 0.95rem; float: right; transition: all 0.3s var(--ease); }
        .modal-close:hover { background: var(--accent); color: white; box-shadow: 0 10px 20px rgba(41,151,255,0.3); }

        /* ==================== 抽卡核心樣式矩陣 ==================== */
        .gacha-view-container {
            display: flex; flex-direction: column; align-items: center; justify-content: center; 
            min-height: 72vh; position: relative; padding-top: 50px;
        }
        /* 內部狀態 Capsule */
        .dynamic-capsule {
            background: var(--capsule-bg); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.08); padding: 10px 24px; border-radius: 30px;
            font-size: 0.9rem; font-weight: 500; letter-spacing: 0.05em; box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            margin-bottom: 30px; display: flex; align-items: center; gap: 10px; transition: all 0.5s var(--fluid-ease);
        }
        .status-dot { width: 8px; height: 8px; background: var(--neon-blue); border-radius: 50%; box-shadow: 0 0 10px var(--neon-blue); }

        /* 核心舞台 */
        .matrix-stage { width: 350px; height: 520px; position: relative; z-index: 10; perspective: 1500px; }
        .pack-container { width: 100%; height: 100%; position: absolute; cursor: pointer; transition: transform 0.5s var(--fluid-ease); transform-style: preserve-3d; }
        .pack-container:hover { transform: scale(1.02) translateY(-4px); }
        .pack-skin { width: 100%; height: 100%; border-radius: 24px; background-size: cover; background-position: center; box-shadow: 0 30px 60px rgba(0,0,0,0.8), inset 0 0 40px rgba(0,0,0,0.6); border: 1px solid rgba(255,255,255,0.15); display: flex; flex-direction: column; justify-content: flex-end; overflow: hidden; }
        .pack-mask { background: linear-gradient(0deg, rgba(9,10,15,0.95) 20%, rgba(9,10,15,0) 100%); padding: 35px 25px; text-align: center; }
        .pack-mask h2 { font-size: 1.3rem; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 4px; color: #fff; }
        .pack-mask p { font-size: 0.75rem; color: #8e8e93; letter-spacing: 0.05em; }

        .pack-rip-animation { animation: fluidRip 0.8s var(--fluid-ease) forwards; }
        @keyframes fluidRip {
            0% { transform: scale(1); filter: brightness(1); }
            40% { transform: scale(1.05); filter: brightness(1.3); }
            100% { transform: scale(0) translateY(-80px); opacity: 0; pointer-events: none; }
        }

        /* 3D 卡牌本體 */
        .card-view-gate { width: 100%; height: 100%; position: absolute; display: none; transform-style: preserve-3d; }
        .premium-ptcg-card { width: 100%; height: 100%; border-radius: 24px; position: relative; transform-style: preserve-3d; background: var(--card-base); color: #1c1c1e; padding: 16px; display: flex; flex-direction: column; border: 5px solid var(--gold-premium); box-shadow: 0 20px 50px rgba(0,0,0,0.5); overflow: hidden; touch-action: none; }
